{
  "name": "hechaichi-library-pos",
  "productName": "Hechaichi Library POS",
  "version": "1.0.0",
  "description": "نظام إدارة المبيعات والمخزون — مكتبة حشايشي",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --ia32"
  },
  "build": {
    "appId": "com.hechaichi.pos",
    "productName": "Hechaichi POS",
    "files": [
      "index.html",
      "display.html",
      "display-admin.html",
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["ia32"] },
        { "target": "portable", "arch": ["ia32"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
